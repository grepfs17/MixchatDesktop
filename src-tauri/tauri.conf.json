{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixchat",
  "version": "0.3.6",
  "identifier": "xyz.grepfs.mixchat",
  "build": {
    "beforeBuildCommand": "pnpm tauri:prepare",
    "frontendDist": "http://localhost:3000",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' http://localhost:* ws://localhost:* https:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mixchat-node"],
    "resources": {
      "resources/mixchat/dist": "mixchat/dist",
      "resources/mixchat/node_modules": "mixchat/node_modules"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
