# MixchatDesktop environment
#
# Copy to `.env` in this project root. The desktop app reads MIXCHAT_* keys for
# its own behavior and forwards the remaining keys to the locally spawned
# Mixchat server at runtime.

# ── Desktop app ───────────────────────────────────────────────────────────────

# Run mode. Usually left unset: `pnpm dev` sets dev, `pnpm start` uses local,
# a packaged build uses packaged.
# MIXCHAT_MODE=dev

# Local server port. Must match the OAuth redirect URIs the Mixchat server was
# built with (default http://localhost:3000/auth/...), so keep 3000 unless you
# also rebuilt Mixchat with matching redirect URIs.
MIXCHAT_PORT=3000

# Address the local server binds to (listen only). Does not affect the window
# origin.
MIXCHAT_HOST=127.0.0.1

# Origin the window loads. MUST match the host used by
# PUBLIC_TWITCH_REDIRECT_URI / PUBLIC_YOUTUBE_REDIRECT_URI, or OAuth login fails
# with "Invalid state parameter" (the oauth_state cookie is host-scoped). The
# Mixchat build uses http://localhost:3000/auth/..., so keep localhost here.
# In dev mode this is the URL of an already-running `pnpm dev` server.
MIXCHAT_URL=http://localhost:3000

# Only needed when the Mixchat checkout is not a sibling ../Mixchat.
# MIXCHAT_DIR=/absolute/path/to/Mixchat

# Explicit Mixchat runtime .env to load. Not needed if you use this file.
# MIXCHAT_ENV_FILE=/absolute/path/to/Mixchat/.env

# Linux only: pass --no-sandbox to Electron. Needed on distros that restrict
# unprivileged user namespaces (e.g. Ubuntu 24.04 default) when chrome-sandbox
# is not setuid root.
# MIXCHAT_NO_SANDBOX=1

# ── Mixchat runtime (all optional) ────────────────────────────────────────────
# These are read live by the spawned server. OAuth client IDs/secrets and
# redirect URIs are NOT here — they come from the Mixchat build. If a
# `.env.desktop` profile exists, the build uses public-client OAuth and bakes
# NO secrets; otherwise `pnpm server:build` falls back to web mode and bakes the
# secrets from ../Mixchat/.env. See `.env.desktop.example`.

# Sent as the Referer/Origin header for Google/YouTube API calls.
ORIGIN=http://localhost:3000

# YouTube InnerTube tuning.
YT_DEBUG=0
# YT_CLIENT=WEB
# YT_USER_AGENT=
# YT_COOKIE=
# YT_GENERATE_SESSION_LOCALLY=true
# YT_MAX_SESSIONS=200
# YT_CHAT_POLL_MIN_MS=2000
# YT_METADATA_POLL_MIN_MS=30000
# YT_CHAT_COOLDOWN_MS=600000
# YT_PLAYABILITY_COOLDOWN_MS=100000
# YT_POTOKEN=
# YT_VISITOR_DATA=

# Storage overrides (default to the Mixchat data/ dir; packaged builds use
# the app's userData dir automatically).
# MIXCHAT_SONG_QUEUE_DIR=
# MIXCHAT_WHEEL_DIR=
