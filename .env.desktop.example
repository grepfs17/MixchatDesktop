# Desktop-mode Mixchat build profile.
#
# Copy to `.env.desktop` and fill in the values, then run `pnpm server:build`.
# When this file exists, the Mixchat bundle is built with PUBLIC_APP_PLATFORM=desktop:
#   - Twitch uses the Device Code Grant (public client, no secret)
#   - Google/YouTube uses PKCE with a "Desktop app" OAuth client (no secret)
#   - client secrets are NOT baked into the app
#
# You must create these OAuth clients yourself (they are separate from the
# hosted website's confidential Twitch app / Web Google client):
#   - Twitch: Register Application -> Client Type = PUBLIC (no secret)
#   - Google: OAuth client -> Application type = "Desktop app"
#
# If `.env.desktop` is absent, `pnpm server:build` falls back to web mode and
# WILL bake the client secrets from ../Mixchat/.env.

PUBLIC_APP_PLATFORM=desktop

# Public Twitch app (Client Type = Public, no secret)
PUBLIC_TWITCH_CLIENT_ID=

# Google "Desktop app" OAuth client id
PUBLIC_YOUTUBE_CLIENT_ID=

# Google "Desktop app" client secret. Google requires a client secret even for
# desktop/PKCE clients ("client_secret is missing" otherwise). Google classes
# desktop-app secrets as non-confidential, and it is baked into the app so users
# need no configuration. Leave blank only if you knowingly accept that YouTube
# login will fail.
YOUTUBE_CLIENT_SECRET=

# Loopback redirect URIs (must be registered on the Google Desktop client).
PUBLIC_TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
PUBLIC_YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# Set to true to disable all Google/YouTube integrations.
PUBLIC_TWITCH_ONLY=false
