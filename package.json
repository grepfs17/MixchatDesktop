{
  "name": "mixchat-desktop",
  "version": "0.3.4",
  "license": "AGPL-3.0",
  "description": "Electron desktop shell that runs the Mixchat Astro server locally.",
  "homepage": "https://mixchat.grepfs.xyz/",
  "author": {
    "name": "Mixchat",
    "email": "noreply@mixchat.grepfs.xyz"
  },
  "private": true,
  "type": "module",
  "main": "src/main/index.mjs",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs local",
    "prepare:server": "node scripts/prepare-mixchat.mjs",
    "server:build": "node scripts/build-mixchat.mjs && node scripts/prepare-mixchat.mjs",
    "clean": "node scripts/clean-release.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "pack": "pnpm prepare:server && electron-builder --dir",
    "pack:win": "pnpm server:build && electron-builder --win --dir && node scripts/make-portable-zip.mjs && pnpm clean",
    "build": "pnpm server:build && electron-builder && pnpm clean",
    "dist": "pnpm server:build && electron-builder --linux && electron-builder --win && node scripts/make-portable-zip.mjs && pnpm clean",
    "release": "pnpm server:build && electron-builder --publish always"
  },
  "dependencies": {
    "@twurple/auth": "^8.1.4",
    "@twurple/chat": "^8.1.4",
    "bgutils-js": "^3.2.0",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.6.16",
    "jsdom": "^29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.7.0",
    "twemoji": "^14.0.2",
    "youtubei.js": "18.1.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
