{
  "name": "mixchat-desktop",
  "version": "0.4.0",
  "license": "AGPL-3.0",
  "description": "Tauri desktop shell that runs the Mixchat Astro server locally.",
  "homepage": "https://mixchat.grepfs.xyz/",
  "repository": {
    "type": "git",
    "url": "https://github.com/grepfs17/MixchatDesktop.git"
  },
  "bugs": {
    "url": "https://github.com/grepfs17/MixchatDesktop/issues"
  },
  "author": {
    "name": "Mixchat",
    "email": "noreply@mixchat.grepfs.xyz"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "start": "node scripts/run-tauri.mjs local",
    "prepare:server": "node scripts/prepare-mixchat.mjs",
    "server:build": "node scripts/build-mixchat.mjs && node scripts/prepare-mixchat.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "fetch-node": "node scripts/fetch-node.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:local": "node scripts/run-tauri.mjs local",
    "tauri:prepare": "node scripts/build-mixchat.mjs && node scripts/prepare-mixchat.mjs && node scripts/prepare-tauri.mjs && node scripts/fetch-node.mjs",
    "tauri:build": "tauri build",
    "tauri:build:portable": "tauri build --no-bundle --config src-tauri/tauri.portable.conf.json && node scripts/make-portable.mjs",
    "tauri:build:portable:win": "node scripts/cross-build-win.mjs",
    "tauri:portable": "node scripts/make-portable.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
